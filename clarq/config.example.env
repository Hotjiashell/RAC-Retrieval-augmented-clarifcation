# Copy to RAC/clarq/.env. The Huawei evaluator reads these values.

# RAC policy model, served through an OpenAI-compatible /v1 endpoint.
POLICY_BASE_URL=http://127.0.0.1:8000/v1
POLICY_MODEL=rac-policy
POLICY_API_KEY=EMPTY
POLICY_TIMEOUT=120
POLICY_MAX_RETRIES=3
POLICY_TEMPERATURE=0
POLICY_MAX_TOKENS=512
# RAC ClarQ enforces this value and rejects an enabled-thinking invocation.
POLICY_ENABLE_THINKING=false
# qwen3_5 uses /chat/completions; qwen3 renders the local tokenizer template
# and uses /completions. Both paths disable thinking for the policy.
POLICY_MODEL_MODE=qwen3_5
POLICY_TOKENIZER_PATH=

# Huawei ClarQ's Qwen user simulator. Its client also always disables thinking.
USER_SIMULATOR_BASE_URL=http://127.0.0.1:8005/v1
USER_SIMULATOR_MODEL=clarq-user-simulator
USER_SIMULATOR_API_KEY=EMPTY
USER_SIMULATOR_TIMEOUT=120
USER_SIMULATOR_MAX_RETRIES=3
USER_SIMULATOR_MODEL_MODE=qwen3_5
USER_SIMULATOR_TOKENIZER_PATH=
EVAL_USER_SIMULATOR_MODE=grounded

# Empty Judge settings make Huawei reuse the simulator where documented.
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=
SUCCESS_JUDGE_BASE_URL=
SUCCESS_JUDGE_MODEL=
SUCCESS_JUDGE_API_KEY=

# The same hybrid retriever used by Huawei ClarQ. RAC begins with the first
# five results from the evaluator's initial query, then refreshes passages from
# each executed search_case result.
SEARCH_SERVER_HOST=http://127.0.0.1:9200
SEARCH_SERVER_STRATEGY=hybrid
ELASTICSEARCH_INDEX=clarq_cases
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=
ELASTICSEARCH_VERIFY_CERTS=true
EMBEDDING_URL=http://127.0.0.1:8001/v1/embeddings
EMBEDDING_MODEL=clarq-embedding
EMBEDDING_API_KEY=EMPTY

EVAL_WORKERS=4
EVAL_MAX_TURNS=6
EVAL_MAX_SEARCHES=4
EVAL_TOP_K=5
EVAL_SUCCESS_TOP_K=3
EVAL_K_VALUES=1,3,5
EVAL_SEED=42
